---
import Layout from '@/layouts/Layout.astro';
import SeasonBanner from '@/components/SeasonBanner.astro';
import LeaderboardCard from '@/components/LeaderboardCard.astro';
import BidModal from '@/components/BidModal.astro';
import FAQSection from '@/components/FAQSection.astro';
import { CATEGORIES, INITIAL_BIDS } from '@/lib/mockData';

const { category } = Astro.params;
const currentCat = CATEGORIES.find((c) => c.slug === category);

if (!currentCat) {
  return Astro.redirect('/404');
}

// Filter bids for this specific category
const categoryBids = INITIAL_BIDS.filter((b) => b.categoryId === currentCat.id)
  .sort((a, b) => b.amountCents - a.amountCents)
  .map((bid, idx) => ({ ...bid, rank: idx + 1 }));
---

<Layout
  title={`${currentCat.name} Instagram Leaderboard | instabid.live`}
  description={`View and compete on the verified ${currentCat.name} Instagram pay-to-rank leaderboard. Direct profile links, live follower counts, and zero ads.`}
  activeCategory={currentCat.slug}
>
  <SeasonBanner seasonNumber={24} totalBidsCount={categoryBids.length} />

  <div class="my-5 sm:my-8 space-y-1.5 sm:space-y-2">
    <div class="flex items-center gap-2.5 sm:gap-3">
      <span class="text-2xl sm:text-3xl">{currentCat.icon}</span>
      <h1 class="text-xl sm:text-2xl md:text-3xl font-black text-slate-900 tracking-tight">
        {currentCat.name} Leaderboard
      </h1>
    </div>
    <p class="text-[11px] sm:text-xs text-slate-600 max-w-2xl">
      {currentCat.description} Bids in this category compete directly for top visibility during Season #24.
    </p>
  </div>

  <section class="space-y-4">
    {
      categoryBids.length > 0 ? (
        categoryBids.map((bid) => <LeaderboardCard bid={bid} />)
      ) : (
        <div class="clay-box p-12 text-center space-y-4 my-8">
          <div class="text-4xl">🚀</div>
          <h3 class="text-xl font-bold text-slate-800">No Bids Placed Yet in {currentCat.name}!</h3>
          <p class="text-xs text-slate-500 max-w-md mx-auto">
            Be the very first creator to claim rank #1 in this category for just $5.00.
          </p>
          <button id="open-bid-modal-btn" class="clay-btn-primary px-6 py-3 text-sm font-bold shadow-lg">
            Claim #1 Spot Now →
          </button>
        </div>
      )
    }
  </section>

  <BidModal />
  <FAQSection />
</Layout>
