---
import Layout from '@/layouts/Layout.astro';
import { CATEGORIES } from '@/lib/mockData';

const pastSeasons = [
  {
    seasonNumber: 23,
    endedAt: '2026-08-17',
    topChampions: [
      { category: 'Web3 & Crypto', handle: 'solana_whale_alpha', bidUSD: 850, clicks: 3820 },
      { category: 'Business & Tech', handle: 'david_indiehacker', bidUSD: 700, clicks: 2410 },
      { category: 'Memes & Culture', handle: 'corporate_humor_daily', bidUSD: 620, clicks: 3100 },
    ],
  },
  {
    seasonNumber: 22,
    endedAt: '2026-08-10',
    topChampions: [
      { category: 'Fashion & Style', handle: 'sophie.styled', bidUSD: 510, clicks: 1980 },
      { category: 'Fitness & Wellness', handle: 'alex_ironphysique', bidUSD: 480, clicks: 1850 },
    ],
  },
];
---

<Layout title="Hall of Fame & Season Archives | instabid.live" description="View past weekly season winners and rank champions on instabid.live.">
  <div class="my-5 sm:my-8 space-y-2 sm:space-y-3 text-center max-w-xl mx-auto">
    <span class="px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full text-[10px] sm:text-xs font-bold bg-amber-500/10 text-amber-600 border border-amber-500/20">
      🏆 HALL OF FAME & ARCHIVES
    </span>
    <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Past Season Champions</h1>
    <p class="text-[11px] sm:text-xs text-slate-600">
      Every weekly season, top rank winners are permanently immortalized in our public archive.
    </p>
  </div>

  <div class="space-y-6 sm:space-y-8 max-w-4xl mx-auto my-6 sm:my-12">
    {
      pastSeasons.map((season) => (
        <div class="clay-box p-4 sm:p-6 md:p-8 space-y-3 sm:space-y-4">
          <div class="flex flex-col xs:flex-row xs:items-center justify-between border-b border-slate-200/60 pb-2.5 sm:pb-3 gap-1">
            <h3 class="text-lg sm:text-xl font-black text-slate-800">Season #{season.seasonNumber} Champions</h3>
            <span class="text-[11px] sm:text-xs font-bold text-slate-500">Ended: {season.endedAt}</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 sm:gap-4 pt-1 sm:pt-2">
            {season.topChampions.map((champ, idx) => (
              <div class="clay-inset p-3 sm:p-4 space-y-1.5 sm:space-y-2 text-center">
                <div class="text-xl sm:text-2xl">{idx === 0 ? '👑' : idx === 1 ? '🥈' : '🥉'}</div>
                <div class="text-[10px] sm:text-xs font-bold text-slate-500 uppercase">{champ.category}</div>
                <a href={`/api/redirect-click?handle=${champ.handle}`} target="_blank" class="block font-black text-xs sm:text-sm text-pink-600 hover:underline">
                  @{champ.handle}
                </a>
                <div class="text-[11px] sm:text-xs font-semibold text-slate-700">Winning Bid: ${champ.bidUSD}</div>
                <div class="text-[10px] sm:text-[11px] text-slate-500">⚡ {champ.clicks.toLocaleString()} clicks earned</div>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</Layout>
