---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="500 - Server Error | instabid.live">
  <div class="clay-box p-12 my-16 max-w-lg mx-auto text-center space-y-6">
    <div class="text-6xl font-black text-rose-600">500</div>
    <h1 class="text-2xl font-black text-slate-800">Server Interruption</h1>
    <p class="text-xs text-slate-500 max-w-sm mx-auto">
      An unexpected error occurred while loading leaderboard data. Our edge network has been alerted.
    </p>
    <a href="/" class="clay-btn-primary inline-flex px-6 py-3 text-xs font-bold shadow-md">
      Reload Leaderboard →
    </a>
  </div>
</Layout>
