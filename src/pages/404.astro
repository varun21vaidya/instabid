---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="404 - Page Not Found | instabid.live">
  <div class="clay-box p-12 my-16 max-w-lg mx-auto text-center space-y-6">
    <div class="text-6xl font-black text-pink-600 animate-pulse">404</div>
    <h1 class="text-2xl font-black text-slate-800">Page Out of Bounds</h1>
    <p class="text-xs text-slate-500 max-w-sm mx-auto">
      The leaderboard page or category you are searching for does not exist or has been moved.
    </p>
    <a href="/" class="clay-btn-primary inline-flex px-6 py-3 text-xs font-bold shadow-md">
      Return to Main Leaderboard →
    </a>
  </div>
</Layout>
