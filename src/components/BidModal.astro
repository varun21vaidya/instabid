---
import { CATEGORIES } from '@/lib/mockData';
---

<!-- Claymorphic Bid Modal Overlay -->
<div
  id="bid-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-slate-900/60 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300"
>
  <div class="clay-box p-4 sm:p-6 md:p-8 max-w-lg w-full max-h-[92vh] overflow-y-auto bg-white/95 relative shadow-2xl rounded-2xl sm:rounded-3xl transition-transform transform scale-95" id="bid-modal-content">
    
    <!-- Close Button -->
    <button
      id="close-modal-btn"
      class="absolute top-3 right-3 sm:top-4 sm:right-4 w-8 h-8 sm:w-9 sm:h-9 rounded-full clay-btn flex items-center justify-center text-slate-500 hover:text-rose-600 font-bold text-sm sm:text-base z-10"
      aria-label="Close modal"
    >
      ✕
    </button>

    <!-- Modal Title -->
    <div class="text-center mb-4 sm:mb-6 pr-6 pl-2">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] sm:text-xs font-bold bg-pink-500/10 text-pink-600 mb-1.5">
        🔒 Verified Instagram Ownership
      </div>
      <h3 class="text-xl sm:text-2xl font-black text-slate-800 tracking-tight">Claim Your Rank</h3>
      <p class="text-[11px] sm:text-xs text-slate-500 mt-0.5">Pay to rank your profile. Outbid competitors instantly.</p>
    </div>

    <!-- Step Progress Indicator (Responsive) -->
    <div class="flex items-center justify-center gap-1 sm:gap-2 mb-4 sm:mb-6 text-[10px] sm:text-xs font-bold">
      <div id="step-indicator-1" class="px-2.5 sm:px-3 py-1 rounded-full bg-pink-600 text-white whitespace-nowrap">
        1. Handle
      </div>
      <span class="text-slate-300 text-xs">→</span>
      <div id="step-indicator-2" class="px-2.5 sm:px-3 py-1 rounded-full bg-slate-200 text-slate-500 whitespace-nowrap">
        2. Verify
      </div>
      <span class="text-slate-300 text-xs">→</span>
      <div id="step-indicator-3" class="px-2.5 sm:px-3 py-1 rounded-full bg-slate-200 text-slate-500 whitespace-nowrap">
        3. Bid & Pay
      </div>
    </div>

    <!-- STEP 1 FORM: Enter Handle & Category -->
    <form id="bid-step-1" class="space-y-3 sm:space-y-4">
      <div>
        <label for="ig-handle-input" class="block text-[10px] sm:text-xs font-extrabold uppercase tracking-wider text-slate-700 mb-1">Instagram Handle</label>
        <div class="relative">
          <span class="absolute left-3.5 top-3 text-slate-400 font-bold text-sm">@</span>
          <input
            type="text"
            id="ig-handle-input"
            required
            placeholder="yourusername"
            autocomplete="off"
            class="clay-inset w-full pl-8 pr-3.5 py-2.5 sm:py-3 text-base sm:text-sm font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-500"
          />
        </div>
      </div>

      <div>
        <label for="category-select" class="block text-[10px] sm:text-xs font-extrabold uppercase tracking-wider text-slate-700 mb-1">Target Category</label>
        <select
          id="category-select"
          required
          class="clay-inset w-full px-3.5 py-2.5 sm:py-3 text-base sm:text-sm font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-500 bg-white/70"
        >
          {CATEGORIES.map((cat) => (
            <option value={cat.slug}>{cat.icon} {cat.name}</option>
          ))}
        </select>
      </div>

      <button type="button" id="goto-step-2-btn" class="clay-btn-primary w-full py-3 sm:py-3.5 text-xs sm:text-sm font-bold shadow-md mt-3 sm:mt-4">
        Generate Verification Code →
      </button>
    </form>

    <!-- STEP 2 FORM: Bio Verification Challenge -->
    <div id="bid-step-2" class="space-y-3 sm:space-y-4 hidden">
      <div class="clay-inset p-3 sm:p-4 bg-amber-500/10 border-amber-500/30 text-amber-900 text-xs rounded-xl sm:rounded-2xl">
        <p class="font-extrabold mb-1 text-xs">⚠️ Bio Verification Challenge</p>
        <p class="text-[11px] sm:text-xs leading-relaxed">Paste this temporary code into your public Instagram bio:</p>
        <div class="flex items-center justify-between bg-white px-3 py-2 rounded-xl mt-2 border border-amber-200 gap-2">
          <code id="challenge-code-display" class="font-mono text-xs sm:text-sm font-black text-pink-600 truncate">instabid-a8f9c2</code>
          <button type="button" id="copy-code-btn" class="text-[10px] font-bold px-2.5 py-1 bg-slate-100 hover:bg-slate-200 rounded text-slate-700 shrink-0">Copy</button>
        </div>
        <p class="mt-2 text-[10px] sm:text-[11px] text-slate-600">You can remove the code right after verification completes (~5 seconds).</p>
      </div>

      <div id="verify-status-msg" class="text-xs font-semibold text-center hidden"></div>

      <div class="flex gap-2 sm:gap-3">
        <button type="button" id="back-to-step-1-btn" class="clay-btn w-1/3 py-2.5 sm:py-3 text-[11px] sm:text-xs font-bold text-slate-700">
          ← Back
        </button>
        <button type="button" id="verify-bio-btn" class="clay-btn-primary w-2/3 py-2.5 sm:py-3 text-xs sm:text-sm font-bold shadow-md">
          Check My Bio ✓
        </button>
      </div>
    </div>

    <!-- STEP 3 FORM: Bid Amount & Checkout -->
    <form id="bid-step-3" class="space-y-3 sm:space-y-4 hidden">
      <div>
        <label for="bid-amount-input" class="block text-[10px] sm:text-xs font-extrabold uppercase tracking-wider text-slate-700 mb-1">Bid Amount ($ USD)</label>
        <div class="relative">
          <span class="absolute left-3.5 top-3 text-slate-400 font-bold text-sm">$</span>
          <input
            type="number"
            id="bid-amount-input"
            min="5"
            max="50000"
            step="1"
            value="10"
            required
            class="clay-inset w-full pl-7 pr-3.5 py-2.5 sm:py-3 text-base sm:text-sm font-black text-slate-900 focus:outline-none focus:ring-2 focus:ring-pink-500"
          />
        </div>
        <p class="text-[10px] sm:text-[11px] text-slate-500 mt-1">Minimum bid is $5.00. Higher bids rank higher on the leaderboard.</p>
      </div>

      <div>
        <label for="bid-desc-input" class="block text-[10px] sm:text-xs font-extrabold uppercase tracking-wider text-slate-700 mb-1">Tagline / Short Description</label>
        <input
          type="text"
          id="bid-desc-input"
          maxlength="80"
          placeholder="e.g. Daily outfit inspo & luxury drops"
          class="clay-inset w-full px-3.5 py-2.5 sm:py-3 text-base sm:text-sm font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-pink-500"
        />
      </div>

      <div class="text-[10px] sm:text-[11px] text-slate-500 leading-tight bg-slate-100 p-2.5 sm:p-3 rounded-xl border border-slate-200">
        💳 Payments processed via PCI-compliant Stripe. By bidding, you agree to our <a href="/terms" class="text-pink-600 underline">Terms of Service</a>.
      </div>

      <div class="flex gap-2 sm:gap-3">
        <button type="button" id="back-to-step-2-btn" class="clay-btn w-1/3 py-2.5 sm:py-3 text-[11px] sm:text-xs font-bold text-slate-700">
          ← Back
        </button>
        <button type="submit" id="submit-checkout-btn" class="clay-btn-primary w-2/3 py-2.5 sm:py-3 text-xs sm:text-sm font-bold shadow-md">
          Pay & Claim Rank 🚀
        </button>
      </div>
    </form>

  </div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('bid-modal');
    const openBtns = document.querySelectorAll('#open-bid-modal-btn');
    const closeBtn = document.getElementById('close-modal-btn');

    const step1 = document.getElementById('bid-step-1');
    const step2 = document.getElementById('bid-step-2');
    const step3 = document.getElementById('bid-step-3');

    const ind1 = document.getElementById('step-indicator-1');
    const ind2 = document.getElementById('step-indicator-2');
    const ind3 = document.getElementById('step-indicator-3');

    const handleInput = document.getElementById('ig-handle-input');
    const challengeDisplay = document.getElementById('challenge-code-display');
    const verifyStatus = document.getElementById('verify-status-msg');

    let currentHandle = '';
    let currentCode = '';

    openBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        modal.classList.remove('opacity-0', 'pointer-events-none');
        modal.classList.add('opacity-100', 'pointer-events-auto');
      });
    });

    closeBtn.addEventListener('click', () => {
      modal.classList.remove('opacity-100', 'pointer-events-auto');
      modal.classList.add('opacity-0', 'pointer-events-none');
    });

    document.getElementById('goto-step-2-btn').addEventListener('click', async () => {
      currentHandle = handleInput.value.trim();
      if (!currentHandle) {
        alert('Please enter your Instagram handle.');
        return;
      }

      // Generate code via API
      try {
        const res = await fetch('/api/verify-bio', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'generate', handle: currentHandle }),
        });
        const data = await res.json();
        currentCode = data.challengeCode;
        challengeDisplay.textContent = currentCode;

        step1.classList.add('hidden');
        step2.classList.remove('hidden');
        ind1.className = 'px-3 py-1 rounded-full bg-slate-200 text-slate-500';
        ind2.className = 'px-3 py-1 rounded-full bg-pink-600 text-white';
      } catch (err) {
        alert('Failed to generate verification code.');
      }
    });

    document.getElementById('copy-code-btn').addEventListener('click', () => {
      navigator.clipboard.writeText(currentCode);
      alert('Verification code copied to clipboard!');
    });

    document.getElementById('back-to-step-1-btn').addEventListener('click', () => {
      step2.classList.add('hidden');
      step1.classList.remove('hidden');
      ind2.className = 'px-3 py-1 rounded-full bg-slate-200 text-slate-500';
      ind1.className = 'px-3 py-1 rounded-full bg-pink-600 text-white';
    });

    document.getElementById('verify-bio-btn').addEventListener('click', async () => {
      verifyStatus.classList.remove('hidden');
      verifyStatus.textContent = '⏳ Checking Instagram bio for token...';
      verifyStatus.className = 'text-xs font-semibold text-center text-amber-600 animate-pulse';

      try {
        const res = await fetch('/api/verify-bio', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'verify', handle: currentHandle, challengeCode: currentCode }),
        });
        const data = await res.json();

        if (data.success) {
          verifyStatus.textContent = '✓ Ownership Verified! Proceeding to bid amount...';
          verifyStatus.className = 'text-xs font-bold text-center text-emerald-600';
          setTimeout(() => {
            step2.classList.add('hidden');
            step3.classList.remove('hidden');
            ind2.className = 'px-3 py-1 rounded-full bg-slate-200 text-slate-500';
            ind3.className = 'px-3 py-1 rounded-full bg-pink-600 text-white';
          }, 600);
        } else {
          verifyStatus.textContent = data.message || 'Verification failed. Code not found in bio.';
          verifyStatus.className = 'text-xs font-bold text-center text-rose-600';
        }
      } catch (err) {
        verifyStatus.textContent = 'Verification error. Try again.';
        verifyStatus.className = 'text-xs font-bold text-center text-rose-600';
      }
    });

    document.getElementById('back-to-step-2-btn').addEventListener('click', () => {
      step3.classList.add('hidden');
      step2.classList.remove('hidden');
      ind3.className = 'px-3 py-1 rounded-full bg-slate-200 text-slate-500';
      ind2.className = 'px-3 py-1 rounded-full bg-pink-600 text-white';
    });

    document.getElementById('bid-step-3').addEventListener('submit', async (e) => {
      e.preventDefault();
      const amountUSD = document.getElementById('bid-amount-input').value;
      const categoryId = document.getElementById('category-select').value;
      const description = document.getElementById('bid-desc-input').value;

      try {
        const res = await fetch('/api/create-checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ handle: currentHandle, categoryId, amountUSD, description }),
        });
        const data = await res.json();
        if (data.url) {
          window.location.href = data.url;
        } else {
          alert(data.error || 'Failed to create checkout session.');
        }
      } catch (err) {
        alert('Payment initialization error.');
      }
    });
  });
</script>
