---
import type { BidItem } from '@/lib/mockData';

interface Props {
  bid: BidItem;
}

const { bid } = Astro.props;
const { profile } = bid;

let badgeClass = 'clay-inset bg-slate-200 text-slate-700';
let rankTitle = `#${bid.rank}`;

if (bid.rank === 1) {
  badgeClass = 'clay-badge-gold';
  rankTitle = '👑 #1 CHAMPION';
} else if (bid.rank === 2) {
  badgeClass = 'clay-badge-silver';
  rankTitle = '🥈 #2 RANK';
} else if (bid.rank === 3) {
  badgeClass = 'clay-badge-bronze';
  rankTitle = '🥉 #3 RANK';
}
---

<div class="clay-box clay-box-hover p-3.5 sm:p-5 md:p-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-3.5 sm:gap-5 md:gap-6 relative overflow-hidden group">
  <!-- Left Side: Rank Badge + Avatar + Profile Details -->
  <div class="flex items-center gap-3 sm:gap-4 md:gap-5 w-full md:w-auto min-w-0">
    <!-- Rank Badge -->
    <div class={`px-2.5 py-1.5 sm:px-3.5 sm:py-2 text-[10px] sm:text-xs font-black rounded-xl sm:rounded-2xl flex items-center justify-center shrink-0 shadow-sm whitespace-nowrap ${badgeClass}`}>
      {rankTitle}
    </div>

    <!-- Instagram Profile Avatar -->
    <div class="relative shrink-0">
      <div class="w-12 h-12 sm:w-14 sm:h-14 md:w-16 md:h-16 rounded-full p-0.5 sm:p-1 bg-gradient-to-tr from-amber-400 via-rose-500 to-purple-600 shadow-md">
        <img
          src={profile.avatarUrl}
          alt={`@${profile.handle} Instagram Avatar`}
          class="w-full h-full rounded-full object-cover bg-white"
          loading="lazy"
          width="64"
          height="64"
        />
      </div>
      {profile.isVerified && (
        <div class="absolute -bottom-0.5 -right-0.5 w-4 h-4 sm:w-5 sm:h-5 bg-blue-500 rounded-full flex items-center justify-center text-white text-[10px] sm:text-xs border-2 border-white shadow" title="Verified Owner">
          ✓
        </div>
      )}
    </div>

    <!-- User Information -->
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-1.5 sm:gap-2 flex-wrap">
        <h3 class="text-sm sm:text-base md:text-lg font-black text-slate-800 tracking-tight group-hover:text-pink-600 transition-colors truncate">
          {profile.displayName}
        </h3>
        <span class="text-[10px] sm:text-xs font-bold text-slate-500 bg-slate-200/80 px-1.5 sm:px-2 py-0.5 rounded-full">
          @{profile.handle}
        </span>
      </div>
      
      <p class="text-[11px] sm:text-xs text-slate-600 mt-0.5 sm:mt-1 line-clamp-2 leading-relaxed">
        {profile.bio}
      </p>

      <div class="flex items-center gap-2 sm:gap-4 mt-1.5 sm:mt-2 text-[10px] sm:text-xs text-slate-500 font-semibold flex-wrap">
        <span class="flex items-center gap-1">
          👥 {(profile.followerCount).toLocaleString()} <span class="hidden xs:inline">followers</span>
        </span>
        <span class="text-slate-300">•</span>
        <span class="flex items-center gap-1 text-pink-600 font-bold">
          ⚡ {bid.clicks.toLocaleString()} clicks
        </span>
      </div>
    </div>
  </div>

  <!-- Right Side: Bid Amount + Action CTA -->
  <div class="flex items-center justify-between md:justify-end gap-3 sm:gap-4 w-full md:w-auto pt-2.5 sm:pt-4 md:pt-0 border-t md:border-t-0 border-slate-200/60 shrink-0">
    <div class="text-left md:text-right">
      <div class="text-[9px] sm:text-xs font-bold text-slate-400 uppercase tracking-wider">Current Bid</div>
      <div class="text-lg sm:text-xl md:text-2xl font-black text-slate-900 tracking-tight">
        ${(bid.amountCents / 100).toLocaleString('en-US', { minimumFractionDigits: 2 })}
      </div>
    </div>

    <!-- Direct Instagram Link Button -->
    <a
      href={`/api/redirect-click?handle=${profile.handle}`}
      target="_blank"
      rel="noopener noreferrer"
      class="clay-btn px-3.5 py-2 sm:px-5 sm:py-2.5 text-[11px] sm:text-xs font-bold text-slate-800 hover:text-pink-600 flex items-center gap-1.5 sm:gap-2 shrink-0 group-hover:scale-105 transition-transform"
      title={`Visit @${profile.handle} on Instagram`}
    >
      <span>Visit</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-pink-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </div>
</div>
