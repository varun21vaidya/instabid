---
interface Props {
  seasonNumber?: number;
  totalBidsCount?: number;
}

const { seasonNumber = 24, totalBidsCount = 8 } = Astro.props;
---

<div class="clay-box p-4 sm:p-6 md:p-8 bg-gradient-to-r from-slate-100 via-pink-50/50 to-slate-100 border border-white/80 relative overflow-hidden">
  <div class="flex flex-col md:flex-row items-center justify-between gap-4 sm:gap-6 relative z-10">
    <div class="space-y-1.5 sm:space-y-2 text-center md:text-left">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full text-[10px] sm:text-xs font-bold bg-pink-500/10 text-pink-600 border border-pink-500/20">
        <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-pink-500 animate-pulse"></span>
        SEASON #{seasonNumber} ACTIVE
      </div>
      <h2 class="text-xl sm:text-2xl md:text-3xl font-black text-slate-800 tracking-tight leading-tight">
        Compete for top Instagram visibility
      </h2>
      <p class="text-[11px] sm:text-xs md:text-sm text-slate-600 max-w-xl leading-relaxed">
        Pay to claim rank in your niche. Bids reset every Sunday at 23:59 UTC. Past winners are immortalized in the Hall of Fame.
      </p>
    </div>

    <!-- Countdown Timer Card -->
    <div class="clay-inset p-2.5 sm:p-4 flex items-center justify-center gap-2.5 sm:gap-4 text-center shrink-0 w-full md:w-auto">
      <div>
        <div class="text-lg sm:text-xl md:text-2xl font-black text-slate-800" id="season-days">04</div>
        <div class="text-[9px] sm:text-[10px] font-bold text-slate-400 uppercase">Days</div>
      </div>
      <span class="text-slate-300 font-bold text-base sm:text-xl">:</span>
      <div>
        <div class="text-lg sm:text-xl md:text-2xl font-black text-slate-800" id="season-hours">09</div>
        <div class="text-[9px] sm:text-[10px] font-bold text-slate-400 uppercase">Hours</div>
      </div>
      <span class="text-slate-300 font-bold text-base sm:text-xl">:</span>
      <div>
        <div class="text-lg sm:text-xl md:text-2xl font-black text-pink-600" id="season-mins">42</div>
        <div class="text-[9px] sm:text-[10px] font-bold text-slate-400 uppercase">Mins</div>
      </div>
      <span class="text-slate-300 font-bold text-base sm:text-xl">:</span>
      <div>
        <div class="text-lg sm:text-xl md:text-2xl font-black text-pink-600 season-seconds" id="season-secs">00</div>
        <div class="text-[9px] sm:text-[10px] font-bold text-slate-400 uppercase">Secs</div>
      </div>
    </div>
  </div>
</div>

<style>
  .season-seconds.tick {
    animation: seconds-tick 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes seconds-tick {
    0% { opacity: 0.35; transform: translateY(-5px) scale(0.92); }
    60% { opacity: 1; transform: translateY(1px) scale(1.06); }
    100% { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .season-seconds.tick { animation: none; }
  }
</style>

<script is:inline>
  const getNextSeasonReset = () => {
    const now = new Date();
    const currentDay = now.getUTCDay(); // 0 = Sunday, 1 = Monday, ... 6 = Saturday

    const sundayReset = new Date(Date.UTC(
      now.getUTCFullYear(),
      now.getUTCMonth(),
      now.getUTCDate(),
      23,
      59,
      0,
      0
    ));

    if (currentDay === 0 && now.getTime() < sundayReset.getTime()) {
      return sundayReset;
    }

    const daysUntilSunday = (7 - currentDay) % 7;
    const nextSunday = new Date(Date.UTC(
      now.getUTCFullYear(),
      now.getUTCMonth(),
      now.getUTCDate() + (currentDay === 0 ? 7 : daysUntilSunday),
      23,
      59,
      0,
      0
    ));

    return nextSunday;
  };

  const pad = (value) => String(Math.max(0, value)).padStart(2, '0');

  const updateSeasonTimer = () => {
    const resetAt = getNextSeasonReset();
    const remaining = Math.max(0, resetAt.getTime() - Date.now());

    const days = Math.floor(remaining / (1000 * 60 * 60 * 24));
    const hours = Math.floor((remaining / (1000 * 60 * 60)) % 24);
    const minutes = Math.floor((remaining / (1000 * 60)) % 60);
    const seconds = Math.floor((remaining / 1000) % 60);

    const dayEl = document.getElementById('season-days');
    const hourEl = document.getElementById('season-hours');
    const minEl = document.getElementById('season-mins');
    const secondEl = document.getElementById('season-secs');

    if (dayEl) dayEl.textContent = pad(days);
    if (hourEl) hourEl.textContent = pad(hours);
    if (minEl) minEl.textContent = pad(minutes);
    if (secondEl) {
      const nextSeconds = pad(seconds);
      if (secondEl.textContent !== nextSeconds) {
        secondEl.textContent = nextSeconds;
        secondEl.classList.remove('tick');
        void secondEl.offsetWidth;
        secondEl.classList.add('tick');
      }
    }
  };

  updateSeasonTimer();
  setInterval(updateSeasonTimer, 1000);
</script>
