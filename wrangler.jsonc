{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "instabid-live",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "instabid.live/*", "zone_name": "instabid.live" },
    { "pattern": "www.instabid.live/*", "zone_name": "instabid.live" }
  ],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "instabid-db",
      "database_id": "104642d9-220d-48df-95b7-6589aa69bf7d"
    }
  ]
}
